# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored -- it will never be committed.
#
# Generate a password hash with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-real-password'))"
# Generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

PANTILT_DASHBOARD_USER=admin
PANTILT_DASHBOARD_PASSWORD_HASH=scrypt:...
PANTILT_DASHBOARD_SECRET_KEY=
